APP_NAME="NGINEER"
APP_ENV="development"
APP_URL="http://localhost:3000"

NEO4J_URI=""
NEO4J_USERNAME=""
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"

# Protects /api/neo4j/keepalive. Generate with: openssl rand -base64 48
NEO4J_KEEPALIVE_ENABLED="true"
NEO4J_KEEPALIVE_TOKEN=""

AI_PROVIDER="openai"
OPENAI_API_KEY=""

AUTH_SECRET=""
SESSION_TIMEOUT_MINUTES="60"

ADMIN_EMAIL=""
ADMIN_NAME=""

ENABLE_AI_ASSISTANT="true"
ENABLE_IPAM="true"
ENABLE_TRAFFIC_PATH_VISUALIZER="true"
ENABLE_MPLS_MODULE="true"
ENABLE_CONFIG_GENERATOR="true"
NEXT_TELEMETRY_DISABLED="1"
